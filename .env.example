# Login opcional: false para red interna, true para exigir acceso.
PI_VIEWER_AUTH_ENABLED=false

# Configura una clave larga y aleatoria en tu .env privado.
PI_VIEWER_AUTH_KEY=

# true para HTTPS; false para HTTP local.
PI_VIEWER_AUTH_SECURE_COOKIE=false

PI_VIEWER_TURNSTILE_SITE_KEY="tu-site-key"
PI_VIEWER_TURNSTILE_SECRET_KEY="tu-secret-key"

PI_VIEWER_VAPID_PUBLIC_KEY=<clave pública VAPID>
PI_VIEWER_VAPID_PRIVATE_KEY=<clave privada VAPID>
PI_VIEWER_VAPID_SUBJECT=mailto:tu-correo@example.com
