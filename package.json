{
  "name": "pi-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.server.config.ts",
    "start": "node --env-file-if-exists=.env dist-server/start.js",
    "test": "tsx --tsconfig tsconfig.app.json --test \"tests/**/*.test.ts\"",
