    "react": "18.3.1",
    "react-dom": "18.3.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.6.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
